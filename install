#!/bin/bash

# Logging functions ─────────────────────────────────────────────────────────────────────
log() {
    echo -e "\033[1;36m💡 [INFO]\033[0m $1"
}
success() {
    echo -e "\033[1;32m✅ [SUCCESS]\033[0m $1"
}
warning() {
    echo -e "\033[1;33m⚠️  [WARNING]\033[0m $1"
}
line() {
    echo "────────────────────────────────────────────────────────────────────────"
}

# 0. Init logic ─────────────────────────────────────────────────────────────────────────
if [ ! -f "$(dirname "$0")/bin/Cargo.toml" ]; then
    line
    log "Fetching the repository"
    tmp_dir=$(mktemp -d)
    git clone --depth 1 https://github.com/O-ELMA/rusty_palette.git "$tmp_dir/rusty_palette" || {
        warning "Could not clone the repository"
        exit 1
    }
    bash "$tmp_dir/rusty_palette/install"
    status=$?
    rm -rf "$tmp_dir"
    exit $status
fi

line
log "Installing the app"
line

APP=rusty_palette
REPO=O-ELMA/rusty_palette
PREFIX="$HOME/.cargo/bin"

case "$(uname -m)" in
    x86_64|amd64)  target=x86_64-unknown-linux-gnu ;;
    aarch64|arm64) target=aarch64-unknown-linux-gnu ;;
    *)             warning "Unsupported architecture: $(uname -m)"; exit 1 ;;
esac

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

if curl -fsL "https://github.com/$REPO/releases/latest/download/$APP-$target.tar.gz" -o "$tmp_dir/$APP.tar.gz" 2>/dev/null; then
    tar -xzf "$tmp_dir/$APP.tar.gz" -C "$tmp_dir"
    mkdir -p "$PREFIX"
    install -m 755 "$tmp_dir/$APP-$target/$APP" "$PREFIX/.$APP.new"
    mv -f "$PREFIX/.$APP.new" "$PREFIX/$APP"
else
    command -v cargo >/dev/null 2>&1 || {
        warning "No prebuilt binary and cargo is missing. Install Rust: https://rustup.rs"
        exit 1
    }
    log "No prebuilt binary, compiling from source"
    cargo install --path ./bin
fi
line

# Check if rofi is installed
if command -v rofi >/dev/null 2>&1; then
    warning "This will override your rofi configuration, make sure you backup your configuration file first."
    confirm=""
    read -r -p "Are you sure you want to continue? [y/N]: " confirm < /dev/tty || {
        warning "No terminal available to ask for confirmation."
        exit 1
    }

    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        log "Aborted."
        exit 1
    fi
    line
fi

# 2. Copy themes to the appropriate dirs ───────────────────────────────────────────────────
log "Copying themes to the packages .config folder"
line
# Check if alacritty is installed
if command -v alacritty >/dev/null 2>&1; then
    mkdir -p ~/.config/alacritty/themes && cp ./themes/alacritty/* ~/.config/alacritty/themes
fi

# Check if btop is installed
if command -v btop >/dev/null 2>&1; then
    mkdir -p ~/.config/btop/themes && cp ./themes/btop/* ~/.config/btop/themes
fi

# Check if rofi is installed
if command -v rofi >/dev/null 2>&1; then
    mkdir -p ~/.config/rofi/themes && cp -r ./themes/rofi/* ~/.config/rofi
fi

# Check if vesktop is installed
if command -v vesktop >/dev/null 2>&1; then
    mkdir -p ~/.config/vesktop/themes && cp ./themes/vesktop/* ~/.config/vesktop/themes
fi


# Copy wallpapers
log "Copying wallapapers to ~/wallpapers"
line
mkdir -p ~/wallpapers               && cp    ./themes/wallpapers/*  ~/wallpapers

## Copy GTK themes ────────────────────────────────────────────────────────────────────────
log "Copying gtk themes to /usr/share/themes"
warn "might require root access"
sudo cp -r ./themes/gtk/* /usr/share/themes
line

# 3. Add theme import to alacritty ────────────────────────────────────────────────────────
grep -qF '~/.config/alacritty/themes/' ~/.config/alacritty/alacritty.toml || sed -i '1igeneral.import = ["~/.config/alacritty/themes/gruvbox.toml"]' ~/.config/alacritty/alacritty.toml


# 4. Install themes on vscodium ───────────────────────────────────────────────────────────
log "Installing Vscodium themes"
xargs -a ./themes/vscodium/extensions -n1 codium --install-extension
line

# 5. Good lucks ───────────────────────────────────────────────────────────────────────────
warning "If you're using neovim, you'll have to copy the themes folder and configure it yourself, since it depends hugely on how you have set it up"
line

success "Done!"
line
